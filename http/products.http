### Filters
# Public, no sign-in needed. Counts only include products that can be bought right now
# (an active offer with an available key), the same products the store list shows.
GET {{baseUrl}}/api/v1/products/filters

### List products
# Public. All query parameters are optional; type, platform, region and genre can be repeated.
# sort: popular (default, also with q), price_asc, price_desc, newest, oldest, name_asc, name_desc. Prices are in cents.
GET {{baseUrl}}/api/v1/products?platform=steam&maxPrice=6000&page=1&limit=24

### Get product
# Public. Returns 404 for an unknown slug. Offers are only the buyable ones, cheapest first.
GET {{baseUrl}}/api/v1/products/elden-ring-pc-steam-key-global

### Product suggestions
# Public. The search box dropdown: up to 6 products plus the total number of matches.
# q is required; fewer than 3 characters returns {"items": [], "total": 0}.
GET {{baseUrl}}/api/v1/products/suggestions?q=wit
