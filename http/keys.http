# Key library of the signed-in user: every key from their PAID orders, newest
# purchase first. The codes are not included; open an order's keys with
# GET /api/v1/orders/{id}/keys (see orders.http) to see them.
# Run "Login" first; GoLand's HTTP client keeps {{accessToken}} for the requests below.
#
# Query parameters (all optional):
#   page   page number, starts at 1 (default 1)
#   limit  keys per page, 1 to 60 (default 10)
#   q      part of a product title or an order's public ID, any case,
#          e.g. "elden" or "o-7j7"

### Login
# Seeded users all use the password Password123!.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "emma.johnson@example.com",
  "password": "Password123!"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### List keys
# 200 {"items": [...], "page": 1, "limit": 10, "total": 2, "totalPages": 1}.
# 400 validation_failed for a bad page, limit or q.
GET {{baseUrl}}/api/v1/keys?page=1&limit=10
Authorization: Bearer {{accessToken}}

### Search keys
# Matches the product title or the order's public ID, partial and case-insensitive.
GET {{baseUrl}}/api/v1/keys?q=elden
Authorization: Bearer {{accessToken}}
