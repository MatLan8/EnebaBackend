# Needs a signed-in user and the cart_token cookie; GoLand keeps both, so run these in order.
# Open the checkoutUrl and pay with test card 4242 4242 4242 4242 (any future expiry, CVC and name).
# offerId is PixelVault's Elden Ring offer; ids change after seed -reset.

# The order only becomes paid via the webhook, so first start the Stripe CLI and put its whsec_...
# in .env as STRIPE_WEBHOOK_SECRET (then restart the API):
#   stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe
@offerId = f26f9e4f-2b98-405d-9b59-c9044d33566c

### Login
# Seeded users all use the password Password123!.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "emma.johnson@example.com",
  "password": "Password123!"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### Add item to cart
# Sets the cart_token cookie on the first add.
POST {{baseUrl}}/api/v1/cart/items
Content-Type: application/json

{
  "offerId": "{{offerId}}"
}

### Checkout
# 201 {"orderId", "checkoutUrl"}; 400 cart_empty, 409 offer_unavailable, insufficient_stock,
# checkout_already_completed or checkout_superseded, 502 if Stripe fails.
# The keys stay reserved for 35 minutes; the cart is emptied only after payment. Running it again
# expires the previous session and cancels its order, so a cart has at most one pending order.
POST {{baseUrl}}/api/v1/checkout
Authorization: Bearer {{accessToken}}
