# Pick the "local" environment in the selector at the top of the editor.
# Register and login save the access token as {{accessToken}};
# the refresh_token cookie is kept and sent automatically by GoLand.

### Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "aa",
  "email": "a@a.com",
  "password": "bbbbbbbbbbbb"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "a@a.com",
  "password": "bbbbbbbbbbbb"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### Refresh
# Swaps the refresh_token cookie for a new one and returns a new access token. No body needed.
POST {{baseUrl}}/api/v1/auth/refresh

> {% client.global.set("accessToken", response.body.accessToken); %}

### Logout
# Revokes the refresh token from the cookie and clears it. No body needed.
POST {{baseUrl}}/api/v1/auth/logout
