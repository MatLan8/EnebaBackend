# The cart lives in the HttpOnly cart_token cookie, which GoLand keeps between requests.
# To start over, clear the cookies (.idea/httpRequests/http-client.cookies) or run "Empty cart".
# offerId is PixelVault's Elden Ring offer; ids change after seed -reset (take one from GET /api/v1/products/{slug}).
@offerId = f26f9e4f-2b98-405d-9b59-c9044d33566c

### Get cart
# Each item has "available": false when its offer is inactive or has fewer free keys than its quantity.
# Without a cart this returns {"items": [], "itemCount": 0, "totalCents": 0, "currency": "EUR"} and creates nothing.
GET {{baseUrl}}/api/v1/cart

### Add item
# Adds one key per call (quantity 1, or +1 if the offer is already in the cart). 404 for an
# unknown or inactive offer, 400 for an 11th key, 409 insufficient_stock if there aren't enough unsold keys.
POST {{baseUrl}}/api/v1/cart/items
Content-Type: application/json

{
  "offerId": "{{offerId}}"
}

### Set item quantity
# Sets the quantity (1 to 10), it doesn't add to it. To remove the item use Remove item.
# 404 if there is no cart yet or the offer isn't in it.
PATCH {{baseUrl}}/api/v1/cart/items/{{offerId}}
Content-Type: application/json

{
  "quantity": 2
}

### Remove item
DELETE {{baseUrl}}/api/v1/cart/items/{{offerId}}

### Empty cart
# Removes every item and returns 204 with no body. The cart and its cookie are kept.
DELETE {{baseUrl}}/api/v1/cart
