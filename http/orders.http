# Run "Login" first; without a token the API answers 401.
# Query (all optional): page (default 1), limit 1 to 60 (default 10), publicId (part, any case).
# Every status is listed; productTitle is null for cancelled orders (their items are deleted).

# orderId is one of emma's orders; replace it with an id from "List orders".
@orderId = aa0bc79b-a3aa-419e-99b7-718fa277506f

### Login
# Seeded users all use the password Password123!.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "emma.johnson@example.com",
  "password": "Password123!"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

### List orders
# 200 {"items": [...], "page": 1, "limit": 10, "total": 3, "totalPages": 1}.
# 400 validation_failed for a bad page or limit.
GET {{baseUrl}}/api/v1/orders?page=1&limit=10
Authorization: Bearer {{accessToken}}

### Search orders by public ID
# Partial and case-insensitive. Replace the value with part of one of your order IDs.
GET {{baseUrl}}/api/v1/orders?publicId=O-
Authorization: Bearer {{accessToken}}

### Get order by id
# 200 with the order and one item per key (no quantity), sellerNames in order of
# first appearance. 404 not_found for an unknown id or another user's order,
# 400 validation_failed when the id isn't a UUID.
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{accessToken}}

### Get order keys
# Paid orders only: 200 with the decrypted codes (sent with Cache-Control: no-store).
# 409 order_not_paid (details.status pending or cancelled) for an unpaid order,
# 404 not_found for an unknown id or another user's order.
GET {{baseUrl}}/api/v1/orders/{{orderId}}/keys
Authorization: Bearer {{accessToken}}
