APP_ENV=development
PORT=8080
DATABASE_URL=postgres://user:password@host:5432/postgres
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=eneba-backend
JWT_AUDIENCE=eneba-frontend
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# 32 random bytes, base64. Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Only sk_test_ keys work outside production.
STRIPE_SECRET_KEY=sk_test_...
# Printed by: stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the buyer back after paying.
FRONTEND_URL=http://localhost:5173
